# =====================================================================
#  New Era Trading — PRODUCTION environment
#  Copy to  backend/.env  on the server, fill every value marked  <<<
#  then run:  php artisan app:check-production
# =====================================================================
APP_NAME="New Era Trading"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://neweratrading.net            # <<< your real https address
FRONTEND_URL=https://neweratrading.net       # <<< same address (the site and /api live on one domain)
APP_KEY=                                      # <<< generate once:  php artisan key:generate --force
DEMO_MODE=false                               # never true in production (free simulated money + reset button)
ACCRUE_ON_REQUEST=false                       # ROI is credited by the scheduler (cron), not by page visits

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---- database (create an empty database + a dedicated user first; do NOT use root) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neweratrading
DB_USERNAME=neweratrading_app                 # NOT root — create it with deploy/database/setup-database.sql
DB_PASSWORD=<<<

# ---- e-mail: every OTP, welcome and withdrawal message goes through this ----
# Any SMTP works (your hosting mailbox, Brevo, Mailgun, Amazon SES, Zoho ...).
MAIL_MAILER=smtp
MAIL_HOST=<<<                                 # e.g. smtp-relay.brevo.com / smtp.zoho.in / mail.yourhost.com
MAIL_PORT=587
MAIL_USERNAME=<<<
MAIL_PASSWORD=<<<
MAIL_SCHEME=null                              # use  smtps  with port 465; keep null for 587 (STARTTLS)
MAIL_FROM_ADDRESS="no-reply@neweratrading.net"
MAIL_FROM_NAME="New Era Trading"
SUPPORT_EMAIL=support@neweratrading.net

# ---- security ----
ADMIN_2FA=true                                # admins confirm every sign-in with an e-mailed code
SANCTUM_EXPIRATION=10080                      # hard upper limit of a login token (minutes); members get 24 h, admins 2 h
CORS_ALLOWED_ORIGINS=https://neweratrading.net
TRUSTED_PROXIES=*                             # only if the site is behind Cloudflare / a load balancer / nginx proxy
SESSION_DRIVER=database
CACHE_STORE=file                              # fast, no database round trip per request. Use redis when you run several web servers
QUEUE_CONNECTION=database
SNAPSHOT_CACHE=60                             # seconds: member count / leaderboard are recomputed at most this often
MEMBER_SNAPSHOT_CACHE=15                      # seconds: a member's dashboard JSON is cached (dropped on their own writes)
BCRYPT_ROUNDS=12

# ---- on-chain deposit check (recommended) ----
# Free key from https://etherscan.io/apis  (V2 API covers BNB Smart Chain). Empty = verify deposits by hand.
ETHERSCAN_API_KEY=
CHAIN_ID=56
USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# ---- backups (daily 02:30 into storage/app/backups) ----
BACKUP_KEEP=14
BACKUP_COPY_PATH=                             # optional 2nd location, e.g. a mounted drive / synced folder
